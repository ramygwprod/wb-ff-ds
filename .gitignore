# Allowlist: this repo is PUBLIC and holds the design system only.
# Everything is ignored by default; only folders and files cleared as DS content are un-ignored below.
# Never un-ignore: existing-platform/, requirements/, _incoming/, _archive/, _delete/, the rest of .claude/

/*
!/.gitignore
!/README.md

# Agent skills only (vendored, hash-pinned); .claude/settings.local.json and the rest of .claude/ stay local
!/.claude/
/.claude/*
!/.claude/skills/

# DS content
!/knowledge-base/
!/tools/
!/releases/
!/projects/

# Angular workspace (generated by Angular CLI 22.2.6)
!/angular.json
!/package.json
!/package-lock.json
!/tsconfig.json
!/.editorconfig
!/.prettierrc
!/.prettierignore
!/.vscode/
!/eslint.config.js

# CI (GitHub Actions)
!/.github/

# Supply-chain and toolchain pinning
!/.npmrc
!/.nvmrc

# AI configuration (generated by `ng new --ai-config=claude-code`)
!/CLAUDE.md
!/.mcp.json

# ---- Angular CLI defaults (apply inside the folders allowed above) ----

# Compiled output
dist/
out-tsc/

# Node
node_modules/
npm-debug.log

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/mcp.json
.history/*

# Miscellaneous
.angular/cache
.sass-cache/
coverage/
__screenshots__/

# System files
.DS_Store
Thumbs.db
