# Supply-chain hardening (agreed 2026-11-08). Applies to everyone who installs: you, CI, agents.
# A new dependency with an unreviewed install script fails the install (review it, then approve or deny in package.json "allowScripts")
strict-allow-scripts=true
# Only install versions published at least 7 days ago
min-release-age=7
# Save new dependencies at exact versions
save-exact=true
# Refuse to run on a Node/npm outside package.json "engines"
engine-strict=true
