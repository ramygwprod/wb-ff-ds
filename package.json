{
  "name": "wb-ff-ds",
  "version": "0.4.0",
  "license": "UNLICENSED",
  "scripts": {
    "ng": "ng",
    "start": "ng serve ferrofluid-ds",
    "build": "npm run build:lib && npm run build:docs",
    "test": "ng test ferrofluid-ds --watch=false",
    "lint": "ng lint",
    "build:lib": "ng build wb-ff-ds",
    "build:docs": "ng build ferrofluid-ds",
    "watch:lib": "ng build wb-ff-ds --watch --configuration development",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "registry:check": "node tools/registry/validate.mjs && node tools/registry/generate.mjs --check && node tools/hooks/check-run-log.mjs",
    "registry:generate": "node tools/registry/generate.mjs",
    "test:tools": "node --test \"tools/**/*.test.mjs\""
  },
  "private": true,
  "packageManager": "npm@11.20.0",
  "dependencies": {
    "@angular/aria": "~22.2.6",
    "@angular/cdk": "~22.2.6",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.0",
    "@eslint/css": "2.0.1",
    "@eslint/js": "10.0.1",
    "ajv": "8.20.0",
    "angular-eslint": "22.6.0",
    "eslint": "10.14.0",
    "jsdom": "^30.0.0",
    "ng-packagr": "^22.2.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.71.0",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "esbuild": false,
    "lmdb": false,
    "msgpackr-extract": false,
    "@parcel/watcher": false,
    "fsevents": false
  },
  "engines": {
    "node": "^26.13.0",
    "npm": "^11.20.0"
  }
}
