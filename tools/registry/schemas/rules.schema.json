{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ramygwprod.github.io/wb-ff-ds/registry/0.1/rules.schema.json",
  "title": "WB-FF-DS registry: a foundation's rules",
  "description": "One testable sentence per rule, with its kind, sources, decisions and consumers.",
  "type": "object",
  "required": ["contractVersion", "foundation", "idPrefix", "status", "groups", "rules"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "contractVersion": {
      "$ref": "common.schema.json#/$defs/semver"
    },
    "foundation": {
      "$ref": "common.schema.json#/$defs/slug"
    },
    "title": {
      "description": "Display name used in generated documents, e.g. 'Layout system'.",
      "$ref": "common.schema.json#/$defs/text"
    },
    "idPrefix": {
      "description": "The letters every rule ID in this file starts with.",
      "type": "string",
      "pattern": "^[A-Z]{1,3}$"
    },
    "status": {
      "enum": ["draft", "approved"],
      "description": "The whole file: approved only when every rule in it is approved."
    },
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z]$"
          },
          "title": {
            "$ref": "common.schema.json#/$defs/text"
          }
        }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/rule"
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/gap"
      },
      "description": "Open questions this foundation is waiting on. Each points to its decision in the register, which holds what it blocks, so the list can't drift from the register."
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "required": ["id", "group", "text", "kind", "consumers", "status"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/ruleId"
        },
        "group": {
          "type": "string",
          "pattern": "^[A-Z]$"
        },
        "text": {
          "$ref": "common.schema.json#/$defs/text"
        },
        "kind": {
          "description": "check: a machine enforces it (lint, test or CI); a rule a script can't test isn't a check. guidance: the agent loads it while working. reference: read when deciding.",
          "enum": ["check", "guidance", "reference"]
        },
        "checkKind": {
          "description": "data: our scripts check token files and generated output. source: lint checks the CSS source. rendered: a check runs on a rendered page. A check runs at the earliest point that can decide it (DEC-036).",
          "enum": ["data", "source", "rendered"]
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/sourceId"
          },
          "uniqueItems": true
        },
        "decisions": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/decisionId"
          },
          "uniqueItems": true
        },
        "dependsOn": {
          "description": "Other rules this one builds on.",
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/ruleId"
          },
          "uniqueItems": true
        },
        "consumers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "common.schema.json#/$defs/consumer"
          },
          "uniqueItems": true
        },
        "status": {
          "description": "draft: written, not approved. proposed: awaiting a decision. approved: agreed.",
          "enum": ["draft", "proposed", "approved"]
        },
        "checkId": {
          "description": "The check that enforces this rule, in tools/checks/registry.json. Check rules only.",
          "type": "string",
          "pattern": "^chk-[a-z0-9-]+$"
        }
      },
      "anyOf": [
        {
          "required": ["sources"]
        },
        {
          "required": ["decisions"]
        },
        {
          "required": ["dependsOn"]
        }
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "check"
              }
            }
          },
          "then": {
            "required": ["checkKind"]
          },
          "else": {
            "properties": {
              "checkKind": false,
              "checkId": false
            }
          }
        }
      ]
    },
    "gap": {
      "type": "object",
      "required": ["gap", "owner", "decision"],
      "additionalProperties": false,
      "properties": {
        "gap": {
          "$ref": "common.schema.json#/$defs/text"
        },
        "owner": {
          "$ref": "common.schema.json#/$defs/text"
        },
        "decision": {
          "description": "The open decision that closes this gap. What it blocks is listed there, not here.",
          "$ref": "common.schema.json#/$defs/decisionId"
        }
      }
    }
  }
}
