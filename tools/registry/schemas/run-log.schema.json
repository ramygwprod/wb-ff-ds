{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ramygwprod.github.io/wb-ff-ds/registry/0.1/run-log.schema.json",
  "title": "WB-FF-DS run log: one line",
  "description": "One event in the public run log (DEC-021). Structured fields and IDs only: no free text, no names of agents without a manifest, and a path only when git publishes it.",
  "type": "object",
  "required": ["v", "at", "event", "agent", "run"],
  "properties": {
    "v": {
      "const": 1
    },
    "at": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])T\\d{2}:\\d{2}:\\d{2}\\.\\d{3}Z$"
    },
    "event": {
      "enum": ["write", "gate"]
    },
    "agent": {
      "description": "A manifest name, or 'unregistered' for any agent without one.",
      "type": "string",
      "pattern": "^(unregistered|[a-z][a-z0-9-]*)$"
    },
    "run": {
      "type": "string",
      "pattern": "^([A-Za-z0-9_-]{1,64})$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "event": {
            "const": "write"
          }
        }
      },
      "then": {
        "required": ["tool", "path", "where", "decision", "why"],
        "additionalProperties": false,
        "properties": {
          "v": true,
          "at": true,
          "event": true,
          "agent": true,
          "run": true,
          "tool": {
            "enum": ["Write", "Edit", "MultiEdit", "NotebookEdit"]
          },
          "path": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]*(/[A-Za-z0-9_-][A-Za-z0-9_.-]*)*$"
              }
            ]
          },
          "where": {
            "enum": ["published", "unpublished", "outside-repo"]
          },
          "decision": {
            "enum": ["allowed", "denied"]
          },
          "why": {
            "enum": [
              "in-scope",
              "out-of-scope",
              "protected",
              "no-manifest",
              "outside-repo",
              "invalid-manifests",
              "guard-error"
            ]
          }
        },
        "if": {
          "properties": {
            "where": {
              "const": "published"
            }
          }
        },
        "then": {
          "properties": {
            "path": {
              "type": "string"
            }
          }
        },
        "else": {
          "properties": {
            "path": {
              "type": "null"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "const": "gate"
          }
        }
      },
      "then": {
        "required": ["claimed", "outcome", "action", "attempt", "checks"],
        "additionalProperties": false,
        "properties": {
          "v": true,
          "at": true,
          "event": true,
          "agent": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$",
            "not": {
              "const": "unregistered"
            }
          },
          "run": true,
          "claimed": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "enum": ["passed", "blocked", "needs-decision", "cancelled"]
              }
            ]
          },
          "outcome": {
            "enum": ["passed", "blocked", "needs-decision", "cancelled"]
          },
          "action": {
            "enum": ["stopped", "sent-back"]
          },
          "attempt": {
            "type": "integer",
            "minimum": 0
          },
          "checks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["script", "passed"],
              "additionalProperties": false,
              "properties": {
                "script": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9:-]*$"
                },
                "passed": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    }
  ]
}
